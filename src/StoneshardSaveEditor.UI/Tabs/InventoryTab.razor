@inherits EditorTab

@if (Error is not null)
{
    <Banner Kind="error">@Error</Banner>
}
@if (Session.GoldNote is not null)
{
    <Banner Kind="warn">@Session.GoldNote</Banner>
}
@if (_removed is not null)
{
    <Banner Kind="warn">@_removed</Banner>
}
<div class="inventory">
    <section class="equipment">
        <h3>Equipped</h3>
        <div class="doll">
            @foreach (var box in Doll)
            {
                <div class="gear-box">
                    @foreach (var cell in box)
                    {
                        @GearSlot(cell, Session.Items.Where(cell.Holds).ToList())
                    }
                </div>
            }
        </div>
        @{
            var others = Session.Items.Where(i => i.Equipped && !Doll.SelectMany(b => b).Any(c => c.Holds(i))).ToList();
        }
        @if (others.Count > 0)
        {
            <div class="doll-other">@GearSlot(null, others)</div>
        }
    </section>

    <section class="backpack">
        <h3>
            Backpack
            <button class="btn gold add-item" disabled="@(!Session.GameFound)" title="@(Session.GameFound ? null : "Game files not found")"
                    @onclick="() => _catalogOpen = true">+ Add item</button>
        </h3>
        <div class="bag" style="width:@(InventoryEditor.Columns * Cell + 2)px;height:@(Session.BagRows * Cell + 2)px">
            @foreach (var item in Session.Items.Where(i => !i.Equipped && i.X is not null))
            {
                <button class="it @(IsSelected(item) ? "sel" : "")" data-index="@item.Index" data-item="@item.Name" title="@EditorService.ItemName(item.Name)"
                        style="left:@(item.X * Cell)px;top:@(item.Y * Cell)px;width:@(item.W * Cell)px;height:@(item.H * Cell)px"
                        draggable="true" @ondragstart="e => StartDrag(item, e)" @ondragend="EndDrag"
                        @onclick="() => Select(item)">
                    <Icon Sprite="@item.Sprite" Width="item.W * Cell" Height="item.H * Cell" Alt="@EditorService.ItemName(item.Name)" />
                    @if (InventoryLayout.Badge(item) is { } badge)
                    {
                        <span class="badge">@badge</span>
                    }
                </button>
            }
            @if (_drag is { } drag)
            {
                @for (var y = 0; y < Session.BagRows; y++)
                {
                    for (var x = 0; x < InventoryEditor.Columns; x++)
                    {
                        var (cx, cy) = (x, y);
                        <div class="cell" data-x="@cx" data-y="@cy" style="left:@(cx * Cell)px;top:@(cy * Cell)px"
                             @ondragenter="() => _hover = (cx, cy)" @ondragover:preventDefault="true" @ondrop="() => DropInBag(cx, cy)"></div>
                    }
                }
                @if (_hover is { } hover && Session.Items.ElementAtOrDefault(drag.Index) is { } dragged)
                {
                    var to = ItemPlace.InBag(hover.X - drag.GrabX, hover.Y - drag.GrabY);
                    <div class="drop-outline @(EditorService.MoveRefusal(drag.Index, to) is null ? "fit" : "clash")"
                         style="left:@(to.X * Cell)px;top:@(to.Y * Cell)px;width:@(dragged.W * Cell)px;height:@(dragged.H * Cell)px"></div>
                }
            }
        </div>
    </section>

    <aside class="panel item-detail">
        @if (Selected is { } sel)
        {
            var (iw, ih) = InventoryLayout.Fit(sel.W, sel.H, 54, 108);
            <div class="head">
                <Icon Sprite="@sel.Sprite" Width="iw" Height="ih" />
                <div>
                    <b>@EditorService.ItemName(sel.Name)</b>
                    <span class="muted key">@sel.Name</span>
                </div>
            </div>
            @if (sel.Stack is { } stack)
            {
                @if (sel.Name == Moneybag)
                {
                    <div class="field" data-field="Gold">
                        <span>Gold</span>
                        <NumberField Value="stack" Whole="true" Min="0" Max="int.MaxValue" OnCommit="v => Edit(() => EditorService.SetPurseGold(sel.Index, (int)v))" />
                    </div>
                    <p class="hint">Up to 2,000 per purse, as stacks of 100; gems and other valuables in it stay.</p>
                }
                else
                {
                    @* Containers (quivers, sacks) cache the total of what's inside; the contents themselves aren't editable here. *@
                    <div class="field" data-field="Holds"><span>Holds</span><span>@stack.ToString("0.##", CultureInfo.InvariantCulture)</span></div>
                }
            }
            @if (sel.Count is { } count)
            {
                <div class="field" data-field="Count">
                    <span>Count</span>
                    <NumberField Value="count" Whole="true" Min="0" Max="int.MaxValue" OnCommit="v => Edit(() => EditorService.SetCount(sel.Index, (int)v))" />
                </div>
            }
            @if (sel.Charges is { } charges)
            {
                <div class="field" data-field="Charges">
                    <span>Charges</span>
                    <NumberField Value="charges" Whole="true" Min="1" Max="sel.MaxCharges ?? charges" OnCommit="v => Edit(() => EditorService.SetCharges(sel.Index, (int)v))" />
                </div>
                <p class="hint">Up to @((sel.MaxCharges ?? charges).ToString("0", CultureInfo.InvariantCulture)), the most any copy has in this save.</p>
            }
            @if (sel.MaxDurability is > 0 and var max)
            {
                var current = sel.Durability ?? 0;
                <div class="field" data-field="Durability">
                    <span>Durability</span>
                    <span class="pair">
                        <NumberField Value="current" OnCommit="v => Edit(() => EditorService.SetDurability(sel.Index, v, max))" />
                        <span class="muted">/</span>
                        <NumberField Value="max" Whole="true" OnCommit="v => Edit(() => EditorService.SetDurability(sel.Index, Math.Min(current, v), v))" />
                    </span>
                </div>
            }
            <div class="detail-actions">
                <button class="btn duplicate" disabled="@(!Session.GameFound)" title="@(Session.GameFound ? null : "Game files not found")"
                        @onclick="() => Edit(() => EditorService.DuplicateItem(sel.Index))">Duplicate</button>
                <button class="btn danger delete" @onclick="() => Delete(sel)">Delete</button>
            </div>
        }
        else
        {
            <p class="muted">Select an item to change it.</p>
        }
    </aside>
</div>

@if (_catalogOpen)
{
    <CatalogDialog OnPick="Add" OnClose="() => _catalogOpen = false" />
}

@code {
    private const int Cell = InventoryLayout.Cell;
    private const string Moneybag = "o_inv_moneybag";

    /// <summary>One drop target of the equipment grid: a slot, in a weapon set for the hands.</summary>
    private sealed record DollCell(string Id, string Label, bool Tall, string Slot, int Set = 0)
    {
        public ItemPlace Place => ItemPlace.Worn(Slot, Set);

        public bool Holds(ItemView item) => item.Equipped && item.Place == Place;
    }

    /// <summary>
    /// The game's layout, three boxes wide. Each weapon set's box holds the right hand and the left (weapon set 0 shows as
    /// "weapon", set 1 as "set 2"), and the rings box holds both rings, so a drop picks the hand or the ring.
    /// </summary>
    private static readonly DollCell[][] Doll =
    [
        [new("neck", "neck", false, GearRules.Neck)],
        [new("head", "head", false, GearRules.Head)],
        [new("back", "back", false, GearRules.Back)],
        [new("weapon-right", "weapon", true, GearRules.RightHand), new("weapon-left", "off-hand", true, GearRules.LeftHand)],
        [new("body", "body", true, GearRules.Body)],
        [new("set2-right", "set 2", true, GearRules.RightHand, 1), new("set2-left", "off-hand", true, GearRules.LeftHand, 1)],
        [new("hands", "hands", false, GearRules.Hands)],
        [new("belt", "belt", false, GearRules.Belt)],
        [new("ring1", "ring", false, GearRules.Ring1), new("ring2", "ring", false, GearRules.Ring2)],
        [],
        [new("feet", "feet", false, GearRules.Feet)],
        [],
    ];

    /// <summary>The item being dragged, and which of its cells the pointer holds it by.</summary>
    private sealed record Drag(int Index, int GrabX, int GrabY);

    private Drag? _drag;
    private (int X, int Y)? _hover;
    private string? _removed;

    /// <summary>Where an item is: its bag cell, or its equipment slot and weapon set. Unlike its list index, this stays
    /// the same when other items are added or deleted.</summary>
    private sealed record Place(string Name, bool Equipped, string Slot, int? WeaponSet, int? X, int? Y);

    private static Place PlaceOf(ItemView item) => new(item.Name, item.Equipped, item.Slot, item.WeaponSet, item.X, item.Y);

    private Place? _selected;
    private bool _catalogOpen;

    /// <summary>The selected item, or null once it is gone.</summary>
    private ItemView? Selected => _selected is null ? null : Session.Items.FirstOrDefault(i => PlaceOf(i) == _selected);

    private bool IsSelected(ItemView item) => _selected is not null && PlaceOf(item) == _selected;

    private void Select(ItemView item) => _selected = PlaceOf(item);

    /// <summary>A box of the equipment grid; <paramref name="cell"/> is null for gear in slots the grid doesn't show.</summary>
    private RenderFragment GearSlot(DollCell? cell, List<ItemView> items) =>
        @<div class="gear-slot @(cell?.Tall == true ? "tall" : "") @DropClass(cell)" data-cell="@(cell?.Id ?? "other")"
              data-slot="@cell?.Slot" data-set="@cell?.Set"
              @ondragover:preventDefault="true" @ondrop="() => DropOn(cell)">
            <span class="lbl">@(cell?.Label ?? "other")</span>
            @foreach (var item in items)
            {
                var (w, h) = InventoryLayout.Fit(item.W, item.H, BoxWidth(cell) / items.Count, cell?.Tall == true ? 156 : 100);
                <button class="equipped @(IsSelected(item) ? "sel" : "")" data-index="@item.Index" data-item="@item.Name"
                        title="@EditorService.ItemName(item.Name)" draggable="true" @ondragstart="() => StartDrag(item, null)" @ondragend="EndDrag"
                        @onclick="() => Select(item)">
                    <Icon Sprite="@item.Sprite" Width="w" Height="h" Alt="@EditorService.ItemName(item.Name)" />
                    @if (InventoryLayout.Badge(item) is { } badge)
                    {
                        <span class="badge">@badge</span>
                    }
                    @if (item.MaxDurability is > 0 and var max)
                    {
                        <span class="dur"><i style="width:@(Percent(item.Durability ?? 0, max))%"></i></span>
                    }
                </button>
            }
        </div>;

    /// <summary>Room for icons: a full box, or half of one for a hand or a ring.</summary>
    private static double BoxWidth(DollCell? cell) => cell is not null && Doll.Any(b => b.Length == 2 && b.Contains(cell)) ? 50 : 104;

    /// <summary>While dragging, whether the item may go in this slot: lit (<c>ok</c>) or faded (<c>no</c>).</summary>
    private string DropClass(DollCell? cell) =>
        _drag is null || cell is null ? "" : EditorService.MoveRefusal(_drag.Index, cell.Place) is null ? "ok" : "no";

    private void StartDrag(ItemView item, DragEventArgs? e)
    {
        var grabX = e is null ? 0 : Math.Clamp((int)(e.OffsetX / Cell), 0, item.W - 1);
        var grabY = e is null ? 0 : Math.Clamp((int)(e.OffsetY / Cell), 0, item.H - 1);
        _drag = new Drag(item.Index, grabX, grabY);
    }

    private void EndDrag()
    {
        _drag = null;
        _hover = null;
    }

    /// <summary>A drop on a backpack cell lands the item with the cell it was grabbed by under the pointer.</summary>
    private void DropInBag(int x, int y)
    {
        if (_drag is { } drag)
            MoveDragged(ItemPlace.InBag(x - drag.GrabX, y - drag.GrabY));
    }

    private void DropOn(DollCell? cell)
    {
        if (cell is not null)
            MoveDragged(cell.Place);
    }

    /// <summary>Moves the dragged item if it may go there (a refused drop does nothing), and selects it.</summary>
    private void MoveDragged(ItemPlace to)
    {
        var drag = _drag;
        EndDrag();
        if (drag is null || EditorService.MoveRefusal(drag.Index, to) is not null)
            return;
        Edit(() =>
        {
            var result = EditorService.MoveItem(drag.Index, to);
            _selected = PlaceOf(EditorService.Current.Items[result.Index]);
            _removed = result.Removed is { } name ? $"{EditorService.ItemName(name)} had no room and was removed" : null;
        });
    }

    private static string Percent(double value, double max) =>
        (Math.Clamp(value / max, 0, 1) * 100).ToString("0.#", CultureInfo.InvariantCulture);

    private void Delete(ItemView item)
    {
        Edit(() => EditorService.DeleteItem(item.Index));
        _selected = null;
    }

    private void Add(string key)
    {
        _catalogOpen = false;
        Edit(() =>
        {
            _selected = PlaceOf(EditorService.AddItem(key).Items[^1]);
        });
    }
}
