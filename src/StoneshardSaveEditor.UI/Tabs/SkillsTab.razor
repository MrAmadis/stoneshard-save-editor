@inherits EditorTab

@if (Error is not null)
{
    <Banner Kind="error">@Error</Banner>
}
@if (_confirmRespec)
{
    <Banner Kind="warn">
        <span>Unlearn every skill you picked and refund the points?</span>
        <button class="btn danger confirm-respec" @onclick="Respec">Respec all</button>
        <button class="btn" @onclick="() => _confirmRespec = false">Cancel</button>
    </Banner>
}

@{
    var tree = CurrentTree;
}
<div class="panel skills-bar">
    @Points(CharacterField.AbilityPoints, "Ability points")
    @Points(CharacterField.StatPoints, "Stat points")
    <button class="btn danger respec" disabled="@(Session.Trees.Count == 0)" @onclick="() => _confirmRespec = true">Respec all</button>
    <button class="btn refund-tree" disabled="@(tree is null || tree.LearnedCount == 0)" @onclick="() => Edit(() => EditorService.RefundTree(tree!.Id, Rules))">Refund this tree</button>
    <label class="rules-toggle" title="@(Session.RulesAvailable ? "Prerequisites and point costs work as in the game" : "Tree rules not loaded yet")">
        <input type="checkbox" class="rules" checked="@Rules" disabled="@(!Session.RulesAvailable)" @onchange="e => _rules = e.Value is true" />
        Follow game rules
    </label>
</div>

@if (tree is null)
{
    <p class="muted placeholder">Skills need the game files, which weren't found.</p>
}
else
{
    <div class="skills">
        <nav class="tree-list">
            @foreach (var t in Session.Trees)
            {
                <button class="tree-item @(t.Id == tree.Id ? "on" : "") @(t.Open ? "" : "closed")" data-tree="@t.Id" @onclick="() => _treeId = t.Id">
                    <span>@t.DisplayName</span>
                    <span class="n">@(t.Open ? t.LearnedCount > 0 ? $"{t.LearnedCount} learned" : "" : "🔒 locked")</span>
                </button>
            }
        </nav>

        <section class="panel tree-view">
            <h3>@tree.DisplayName@(tree.Open ? "" : " 🔒")</h3>
            @if (!tree.Open)
            {
                <p class="muted">This tree is closed, as if you never read its treatise.</p>
                <button class="btn gold unlock-tree" disabled="@(!tree.CanUnlock)" title="@(tree.CanUnlock ? null : "There's no unlock data for this tree yet")"
                        @onclick="() => Edit(() => EditorService.UnlockTree(tree.Id))">Unlock tree</button>
            }
            @if (SkillTreeDrawing.For(tree) is { } drawing)
            {
                <div class="skill-tree" style="width:@(drawing.Width)px;height:@(drawing.Height)px">
                    <svg class="links" width="@drawing.Width" height="@drawing.Height" aria-hidden="true">
                        @foreach (var link in drawing.Links)
                        {
                            <g class="@LinkClass(tree, link)" data-parents="@string.Join(' ', link.Parents)" data-children="@string.Join(' ', link.Children)">
                                <path d="@link.Path" />
                                @foreach (var (x, y) in link.Dots)
                                {
                                    <circle cx="@x.ToString("0.#", CultureInfo.InvariantCulture)" cy="@y.ToString("0.#", CultureInfo.InvariantCulture)" r="3" />
                                }
                            </g>
                        }
                    </svg>
                    @foreach (var (top, skills) in drawing.Rows)
                    {
                        <div class="skill-row centered" style="top:@(top)px">
                            @foreach (var skill in skills)
                            {
                                @SkillButton(tree, skill)
                            }
                        </div>
                    }
                </div>
            }
            else
            {
                @foreach (var (label, passive) in Rows)
                {
                    <div class="row-label">@label</div>
                    <div class="skill-row">
                        @foreach (var skill in tree.Skills.Where(s => s.Passive == passive))
                        {
                            @SkillButton(tree, skill)
                        }
                    </div>
                }
            }
            <div class="legend">
                <span><b class="learned"></b>learned (click to unlearn)</span>
                <span><b class="available"></b>available (click to learn)</span>
                <span><b class="locked"></b>locked</span>
            </div>
        </section>
    </div>
}

@code {
    private static readonly (string Label, bool Passive)[] Rows = [("Passives", true), ("Abilities", false)];

    private string? _treeId;
    private string? _hover;
    private bool _rules = true;
    private bool _confirmRespec;

    /// <summary>Game rules apply only once the tree layouts (prerequisites) are loaded.</summary>
    private bool Rules => Session.RulesAvailable && _rules;

    /// <summary>The picked tree, or at first the first tree with learned skills.</summary>
    private SkillTreeView? CurrentTree =>
        Session.Trees.FirstOrDefault(t => t.Id == _treeId)
        ?? Session.Trees.FirstOrDefault(t => t.LearnedCount > 0)
        ?? Session.Trees.FirstOrDefault();

    private RenderFragment Points(CharacterField field, string label) =>
        @<text>
            @if (Session.Character.TryGetValue(field, out var value))
            {
                <span class="field" data-field="@field">
                    <span>@label</span>
                    <NumberField Value="value" Whole="true" OnCommit="v => Edit(() => EditorService.SetCharacter(field, v))" />
                </span>
            }
        </text>;

    private RenderFragment SkillButton(SkillTreeView tree, SkillView skill) =>
        @<span class="skill-cell" data-skill="@skill.Object" @onmouseover="() => _hover = skill.Object" @onmouseout="() => _hover = null">
            <button class="skill @State(skill)" data-skill="@skill.Object" disabled="@(!Clickable(tree, skill))" title="@Tip(tree, skill)"
                    @onclick="() => Toggle(skill)">
                <Icon Sprite="@skill.Sprite" Width="48" Height="48" Alt="@skill.DisplayName" />
                <span class="nm">@skill.DisplayName</span>
            </button>
        </span>;

    /// <summary>Gold once everything the link needs is learned; highlighted while one of its skills is under the mouse.</summary>
    private string LinkClass(SkillTreeView tree, SkillTreeDrawing.Link link)
    {
        var met = link.Parents.All(p => tree.Skills.Any(s => s.Object == p && s.Learned));
        var hover = _hover is not null && (link.Parents.Contains(_hover) || link.Children.Contains(_hover));
        return $"{(met ? "met" : "")} {(hover ? "hi" : "")}".Trim();
    }

    private static List<string> NeedNames(SkillTreeView tree, SkillView skill) =>
        skill.Requires.Select(o => tree.Skills.FirstOrDefault(s => s.Object == o)?.DisplayName ?? o).ToList();

    /// <summary>With game rules, availability follows the prerequisites; without, the save's own lock flag.</summary>
    private string State(SkillView skill) => skill.Learned ? "learned" : (Rules ? skill.Available : !skill.Locked) ? "available" : "locked";

    /// <summary>
    /// Learned and available skills toggle. Without game rules a locked skill can be learned directly too, which the
    /// game accepts (in-game findings A3). Skills of a closed tree wait for "Unlock tree".
    /// </summary>
    private bool Clickable(SkillTreeView tree, SkillView skill) => tree.Open && (skill.Learned || !Rules || skill.Available);

    private string Tip(SkillTreeView tree, SkillView skill) => (tree.Open, skill.Learned, State(skill) == "locked", Rules) switch
    {
        (false, _, _, _) => "Unlock the tree first",
        (_, true, _, true) => "Learned. Click to unlearn and get the ability point back",
        (_, true, _, false) => "Learned. Click to unlearn",
        (_, _, false, true) => "Click to learn for 1 ability point",
        (_, _, false, false) => "Click to learn",
        (_, _, true, true) => skill.Requires.Count > 0 ? $"Locked: learn {Names.List(NeedNames(tree, skill))} first" : "Locked: learn the skills before it first",
        _ => "Locked in the game. Click to learn it anyway",
    };

    private void Toggle(SkillView skill) => Edit(() =>
    {
        if (skill.Learned)
            EditorService.UnlearnSkill(skill.Object, Rules);
        else
            EditorService.LearnSkill(skill.Object, Rules);
    });

    private void Respec()
    {
        _confirmRespec = false;
        Edit(() => EditorService.RespecAll(Rules));
    }
}
